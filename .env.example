# Copy this file to .env.local. Never commit .env.local.

# Browser-visible URL for the Spring Boot API.
# VITE_ variables are included in the frontend bundle, so never put secrets here.
VITE_API_BASE_URL="http://localhost:8081"

# Spring Boot contact email settings. Keep these on the backend host only.
CONTACT_MAIL_ENABLED="true"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
CONTACT_TO_EMAIL="pelinzeynepkaya@gmail.com"
CONTACT_FROM_EMAIL="Portfolio <hello@your-verified-domain.com>"
